# 이 파일을 .env 로 복사해서 쓴다:  cp .env.example .env

# API 서버 주소 (스킴 포함). axios baseURL 과 socket.io 접속에 쓰인다.
VITE_API_BASE_URL=http://localhost:3000

# 위 주소의 호스트 부분만 (스킴 없이). index.html 의 CSP connect-src 에 치환된다.
# VITE_API_BASE_URL 과 반드시 같은 호스트를 가리켜야 한다 —
# 어긋나면 화면은 뜨는데 모든 API 요청이 CSP 위반으로 차단된다.
VITE_API_HOST=localhost:3000
